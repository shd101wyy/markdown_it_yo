// Library root module — markdown_it_yo
//
// A Yo port of markdown-it (v14.1.1), a modern pluggable markdown parser.
// The renderer — the package's primary API, re-exported so a consumer can
// write import("markdown_it_yo") and get it.
{ MarkdownIt, new_markdown_it, new_markdown_it_with_options } :: import("./markdown_it.yo");
{ Options, default_options, commonmark_options } :: import("./options.yo");

// Core types
{ Token, StringPair } :: import("./token.yo");
{ Ruler, RuleEntry } :: import("./ruler.yo");

// Common utilities
{
  is_valid_entity_code,
  from_code_point,
  escape_html,
  is_space,
  is_white_space,
  is_md_ascii_punct,
  unescape_md,
  normalize_reference,
  array_replace_at,
  byte_substring
} :: import("./common/utils.yo");
{ html_blocks } :: import("./common/html_blocks.yo");
{ html_re, HtmlRegexPatterns } :: import("./common/html_re.yo");

export(
  MarkdownIt,
  new_markdown_it,
  new_markdown_it_with_options,
  Options,
  default_options,
  commonmark_options,
  Token,
  StringPair,
  Ruler,
  RuleEntry,
  is_valid_entity_code,
  from_code_point,
  escape_html,
  is_space,
  is_white_space,
  is_md_ascii_punct,
  unescape_md,
  normalize_reference,
  array_replace_at,
  byte_substring,
  html_blocks,
  html_re,
  HtmlRegexPatterns
);
